{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://locqa.local/reviews.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_locale",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "target_locale": {
      "type": "string",
      "minLength": 2
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "entry_id",
          "decision",
          "original_text",
          "approved_text",
          "source_hash",
          "original_hash",
          "approved_hash",
          "reviewer",
          "reviewed_at",
          "reviewed_by_human"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "entry_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "accepted",
              "edited",
              "rejected"
            ]
          },
          "original_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "approved_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "original_hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "approved_hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "reviewed_by_human": {
            "const": true
          }
        }
      }
    }
  }
}
