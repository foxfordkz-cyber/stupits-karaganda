{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://locqa.local/duplicate-resolutions.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_sha256",
    "original_target_sha256",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "original_target_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "occurrence",
          "chosen_hash",
          "reviewer",
          "reviewed_at",
          "reviewed_by_human"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "occurrence": {
            "type": "integer",
            "minimum": 1
          },
          "chosen_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "reviewed_by_human": {
            "const": true
          }
        }
      }
    }
  }
}
