{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://locqa.local/bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_locale",
    "target_locale",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_locale": {
      "type": "string",
      "minLength": 2
    },
    "target_locale": {
      "type": "string",
      "minLength": 2
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "key",
          "occurrence",
          "source",
          "target",
          "source_hash",
          "target_hash",
          "context"
        ],
        "properties": {
          "entry_id": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "occurrence": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "target_hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "section": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "references": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
