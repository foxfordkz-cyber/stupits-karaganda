{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bekzat shared finding (strict nine-field contract)",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "issue_type", "severity", "source", "target", "evidence", "suggestion", "confidence", "reviewed_by_human"],
  "properties": {
    "key": {"type": "string", "minLength": 1},
    "issue_type": {"enum": ["glossary_violation", "inconsistent_term", "machine_translation_suspect", "orthography", "wrong_language", "suffix_harmony"]},
    "severity": {"enum": ["high", "medium", "low"]},
    "source": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "evidence": {"type": "string", "pattern": "\\S"},
    "suggestion": {"type": "string", "pattern": "\\S"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reviewed_by_human": {"const": false}
  }
}
